{
  "name": "tak-plugin-ui-builder",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Drag-and-drop UI designer for TAK plugins that exports a coding-agent handoff package",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "schema": "tsx scripts/gen-schema.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.1.0",
    "html-to-image": "1.11.11",
    "jszip": "3.10.1",
    "pinia": "2.2.6",
    "typo-js": "1.2.4",
    "vue": "3.5.13",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/jsdom": "21.1.7",
    "@types/node": "20.17.6",
    "@types/typo-js": "1.2.2",
    "@vitejs/plugin-vue": "5.2.1",
    "jsdom": "25.0.1",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8",
    "vue-tsc": "2.1.10",
    "zod-to-json-schema": "3.23.5"
  }
}
